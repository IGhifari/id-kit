{
  "name": "@ghifari29/id-kit",
  "version": "0.4.0",
  "description": "Utilitas Indonesia: terbilang, rupiah, nomor telepon, dan lainnya",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./format": {
      "types": "./dist/format.d.ts",
      "import": "./dist/format.js",
      "require": "./dist/format.cjs"
    },
    "./phone": {
      "types": "./dist/phone.d.ts",
      "import": "./dist/phone.js",
      "require": "./dist/phone.cjs"
    },
    "./nik": {
      "types": "./dist/nik.d.ts",
      "import": "./dist/nik.js",
      "require": "./dist/nik.cjs"
    },
    "./mask": {
      "types": "./dist/mask.d.ts",
      "import": "./dist/mask.js",
      "require": "./dist/mask.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "indonesia",
    "terbilang",
    "rupiah",
    "nik",
    "phone"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IGhifari/id-kit.git"
  },
  "homepage": "https://github.com/IGhifari/id-kit#readme",
  "bugs": "https://github.com/IGhifari/id-kit/issues",
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
